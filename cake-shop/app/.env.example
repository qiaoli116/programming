# Copy to .env and fill in. .env is git-ignored.
ANTHROPIC_API_KEY=<api key value>
BAKER_PASSWORD=change-me
# ASSISTANT_PROVIDER=fake uses an offline stand-in for the AI (no key, no network). Use it for demos and tests.
# ASSISTANT_PROVIDER=fake
# XRAY=off hides the X-ray window button and records nothing. It is on by default (for the demo); the trace shows what the AI was asked and answered.
# XRAY=off
